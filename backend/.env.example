# Server
PORT=5000
NODE_ENV=development

# MongoDB — local example or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/devhire

# CORS — frontend origin allowed to call this API with credentials
FRONTEND_ORIGIN=http://localhost:3001

# Public API origin (absolute upload/avatar URLs, not a secret)
PUBLIC_API_URL=http://localhost:5000

# JWT — production rejects weak defaults (must be ≥32 chars, no "change-me")
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Cookies — Secure is forced when NODE_ENV=production
COOKIE_SECURE=false

# SMTP / Nodemailer — leave blank for local without email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DevHire <noreply@devhire.local>"

# Email worker: inline (API process) | external (npm run worker:email) | off
EMAIL_WORKER_MODE=inline

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Storage: local (dev) | s3 (production object storage)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional — required only for multi-instance Socket.IO (document before enabling)
REDIS_URL=
