# Server
PORT=5000
NODE_ENV=development

# MongoDB — local example or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/devhire

# CORS — frontend origin allowed to call this API with credentials
FRONTEND_ORIGIN=http://localhost:3001

# JWT (Phase 2+) — use long random secrets in real environments
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Cookies (Phase 2+)
COOKIE_SECURE=false

# SMTP / Nodemailer (Phase 7) — leave blank for local without email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DevHire <noreply@devhire.local>"

# File uploads (Phase 7)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
